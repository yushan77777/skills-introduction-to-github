# systemd unit for the unified ETL & Monitoring platform.
#
#   sudo cp deploy/etl-monitoring.service /etc/systemd/system/
#   sudo cp deploy/environment.example /etc/etl-monitoring/environment
#   sudo chmod 600 /etc/etl-monitoring/environment
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now etl-monitoring
#
# Replace every <PLACEHOLDER> below before installing.

[Unit]
Description=ETL & Monitoring platform (Django)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all

# IMPORTANT: run as the user that already owns the ETL runtime and its data
# directories. The web application starts the ETL as a child process, so it
# inherits this identity — a different user will fail on file permissions, and
# will not be able to stop a run it did not start.
User=<ETL_SERVICE_USER>
Group=<ETL_SERVICE_GROUP>

WorkingDirectory=<APP_ROOT>
EnvironmentFile=/etc/etl-monitoring/environment
ExecStart=<APP_ROOT>/venv/bin/gunicorn \
    -c <APP_ROOT>/deploy/gunicorn.conf.py \
    monitoring_site.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# KillMode=mixed stops gunicorn without signalling the whole cgroup, so a
# restart of the web application does not kill an ETL that is midway through
# writing to Greenplum. The run keeps going; the next web process finds it
# through the lock file and offers a Stop button for it.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# The ETL needs to reach Oracle, Greenplum, Spark and the shared filesystem, so
# the sandbox stays deliberately loose. Do not add ProtectHome or a strict
# ReadWritePaths without checking every path in config.yaml first.
#
# Spark is not configured from this unit's environment, and does not need to
# be: build_spark() reads every Spark setting from spark_properties in the
# ETL's own config/config.yaml. See README section 10.3.
NoNewPrivileges=yes
PrivateTmp=no

[Install]
WantedBy=multi-user.target
