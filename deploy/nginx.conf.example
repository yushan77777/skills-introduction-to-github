# nginx in front of the unified platform.
#
# The application serves no static files of its own once DJANGO_DEBUG=0, so
# either nginx serves them (below) or you add a static-file middleware. Run
# `python manage.py collectstatic` after every deployment.

server {
    listen 80;
    server_name etl-monitoring.internal;

    # Collected by `manage.py collectstatic` into <APP_ROOT>/staticfiles.
    location /static/ {
        alias <APP_ROOT>/staticfiles/;
        access_log off;
        expires 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # The ETL app records the client address as "Triggered by", so this
        # header is what puts a real address in the execution history instead
        # of 127.0.0.1.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The ETL status endpoint is polled about once a second while a run is
        # in progress; the defaults are fine, but do not buffer the log file
        # download.
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
