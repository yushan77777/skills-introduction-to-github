# Runtime artefacts - the directories are kept, their contents are not committed.
logs/*
!logs/.gitkeep
parquet/*
!parquet/.gitkeep
processed/*
!processed/.gitkeep

# The live configuration holds the Greenplum/SMTP passwords in clear text.
# Only the example (dummy values) is committed.
config/*.conf
!config/*.conf.example

__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
